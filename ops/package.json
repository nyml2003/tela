    "check": "tsc --noEmit && eslint . && node --test \"src/**/*.test.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
