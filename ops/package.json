{
  "name": "tela-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "tela 开发运维工作流（DDD 分层，运行时零第三方依赖）",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ops": "./src/interface/cli.ts"
  },
  "scripts": {
    "dev": "node src/interface/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
